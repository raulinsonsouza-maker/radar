# PostgreSQL local — use PG 17 (porta 5433) com senha admin `postgres`
# Se preferir outra instância, ajuste host/porta/senha.

DATABASE_URL=postgresql://prospeccao:prospeccao@localhost:5433/prospeccao
POSTGRES_USER=prospeccao
POSTGRES_PASSWORD=prospeccao
POSTGRES_DB=prospeccao
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# API
